<?xml version="1.0" encoding="UTF-8"?>
<!--
  Code that is wrong on purpose: a hard-coded password, MD5, SQL built from a string, an unclosed file, a comparison
  of a value with itself, and no tests at all. It is analysed by the same SonarQube as the real service, and the
  pipeline requires the quality gate to FAIL on it, so a gate that has quietly started passing everything is noticed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>demo</groupId>
  <artifactId>bad-code</artifactId>
  <version>0.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sonar.projectKey>demo-bad-code</sonar.projectKey>
    <sonar.projectName>demo-bad-code</sonar.projectName>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
